@article{seifert_patientcontrolled_2026,
	title = {Patient‐{Controlled} {Sedation} in {Port} {Implantation} ({PACSPI} 2)—{A} {Randomised} {Clinical} {Trial}},
	volume = {70},
	issn = {0001-5172, 1399-6576},
	shorttitle = {Patient‐{Controlled} {Sedation} in {Port} {Implantation} ( {\textless}span style="font-variant},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/aas.70148},
	doi = {10.1111/aas.70148},
	abstract = {Optimising pain management during subcutaneous venous port (SVP) implantation is essential for patient-centred cancer care. However, evidence-based approaches to minimise intraoperative pain remain underexplored. This trial evaluated the clinical effectiveness and safety of the propofol-alfentanil patient-controlled sedation (PCS) technique as an adjunct to local anaesthesia (LA) for pain reduction during SVP implantation. Adult cancer patients at two Swedish anaesthesia departments received either LA + PCS or LA alone for SVP implantation. The primary outcome was the maximum intraoperative pain score on an 11-point numeric rating scale (NRS). Safety outcomes included respiratory, haemodynamic and insertion-related complications. Secondary outcomes assessed patient satisfaction and procedural measurements. A total of 340 patients (median age 70 [interquartile range, [IQR] 61–76], 51.8\% male) were recruited between January 2023 and November 2024. Median intraoperative NRS pain scores were similar between groups (2 [0–3] vs. 2 [0–3], p = 0.292), with pain scores ≥ 4 reported in 22.9\% (LA + PCS) and 22.2\% (LA) (OR 0.96; 95\% CI 0.57–1.60; p = 0.872). Hypoxia or obstructed airway occurred in 2/166 (1.2\%) patients in the LA + PCS group and none in the LA group. Patient satisfaction was high in both groups (10 [10–10], p = 0.102). Optimal procedural conditions were reported more frequently with LA + PCS (96.4\% vs. 82.0\%; OR 5.84; 95\% CI 2.36–14.44; p {\textless} 0.001), without affecting perioperative workflow. Propofol-alfentanil PCS does not significantly reduce intraoperative pain in patients during SVP implantation. Its routine use for pain reduction cannot be recommended. However, PCS may reasonably be offered to patients who prefer procedural sedation.},
	language = {en},
	number = {1},
	urldate = {2026-10-16},
	journal = {Acta Anaesthesiologica Scandinavica},
	author = {Seifert, Stefanie and Taxbro, Knut and Nilsson, Andreas and Azman, Josip and Chew, Michelle S. and Hammarskjöld, Fredrik},
	month = jan,
	year = {2026},
	pages = {e70148},
	file = {PDF:/Users/martin/Zotero/storage/UNA65BU9/Seifert et al. - 2026 - Patient‐Controlled Sedation in Port Implantation (PACSPI 2)—A Randomised Clinical Trial.pdf:application/pdf},
}

@article{seifert_quality_2026,
	title = {Quality of recovery ({QoR}-15) after patient-controlled sedation during venous port implantation: {A} prespecified substudy of the {PACSPI}-2 randomised clinical trial},
	volume = {21},
	issn = {1932-6203},
	shorttitle = {Quality of recovery ({QoR}-15) after patient-controlled sedation during venous port implantation},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0360479},
	doi = {10.1371/journal.pone.0360479},
	abstract = {Background Postoperative recovery after subcutaneous venous port implantation is generally considered uncomplicated; however, patient-reported recovery outcomes in patients with cancer remain poorly characterized. The impact of patient-controlled sedation (PCS) on postoperative recovery has not been established. Objective To assess early postoperative recovery using the Quality of Recovery-15 (QoR-15) questionnaire in a prespecified substudy of the PACSPI-2 randomised clinical trial and to compare recovery between patients receiving local anaesthesia alone and those receiving local anaesthesia combined with patient-controlled sedation. Design and setting Prespecified substudy of a randomised, open-label clinical trial conducted at two Swedish anaesthesia departments. Patients Three hundred thirty-four adult patients with cancer. Interventions Local anaesthesia (LA) alone or LA combined with propofol-alfentanil PCS during SVP implantation. Main outcome measures Primary outcome was difference of postoperative total QoR-15 scores between groups. The primary endpoint of the parent PACSPI-2 trial was maximal intraprocedural pain. Results There was no overall difference in total postoperative QoR-15 scores between the treatment groups (P = 0.61). Total QoR-15 scores changed significantly over time (P {\textless} 0.001) in both groups. By postoperative day 1 (POD 1), mean QoR-15 scores had increased from baseline in both groups (mean difference 2.9 and 3.1, respectively; P = 0.02 for both), although these changes were below the published minimal clinically important difference (MCID) of 6. Before discharge, the LA + PCS group showed its largest within-group improvement in QoR-15 (mean difference 5.6, P {\textless} 0.001), primarily driven by the “Emotional state” and “Psychological support” dimensions, however no significant between group differences were observed. Median pain scores on POD 1 were 3 (IQR 2–5) in both groups, with NRS ≥ 4 reported by 49\% in the LA and 48\% in the LA + PCS group. Conclusions Early postoperative recovery after subcutaneous venous port implantation was generally good and did not differ between the LA and LA + PCS group. A transient within-group improvement in emotional and psychological recovery domains was observed before discharge in the LA + PCS group. Pain on POD 1 remained common in both groups. These findings were based on secondary analyses and should therefore be considered exploratory. Trial registration European Union Clinical Trials Registry: EudraCT: 2021-003821-31, ClinicalTrials.gov: NCT05688384},
	language = {en},
	number = {10},
	urldate = {2026-10-16},
	journal = {PLOS ONE},
	publisher = {Public Library of Science},
	author = {Seifert, Stefanie and Nilsson, Andreas and Azman, Josip and Eriksson, Olle and Chew, Michelle S. and Hammarskjöld, Fredrik and Taxbro, Knut},
	year = {2026},
	keywords = {Emotions, Local and regional anesthesia, Medical implants, Pain, Pain management, Sedation, Surgical and invasive medical procedures, Sweden},
	pages = {e0360479},
	file = {Full Text PDF:/Users/martin/Zotero/storage/66RQWZUQ/Seifert et al. - 2026 - Quality of recovery (QoR-15) after patient-controlled sedation during venous port implantation A pr.pdf:application/pdf},
}
